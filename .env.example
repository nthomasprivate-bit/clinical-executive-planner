# Documentation only: .env files are not automatically loaded.
# Use a managed secret store for deployment. Never commit actual credentials.
PLANNER_DEPLOYMENT=local-demo
# Generate using: python -m clinical_planner.security hash-password
# PLANNER_AUTH_PASSWORD_HASH=pbkdf2_sha256$...
# Optional override; defaults to data/planner.db beneath the project directory.
# PLANNER_DB_URL=sqlite:////absolute/path/planner.db
